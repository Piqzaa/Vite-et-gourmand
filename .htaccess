<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquer l'accès direct aux dossiers sensibles
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^DataBase/ - [F,L]
    RewriteRule ^views/ - [F,L]
    RewriteRule ^docker/ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule \.env$ - [F,L]
</IfModule>

# Bloquer l'accès aux fichiers cachés (commençant par .)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Désactiver le listage des répertoires
Options -Indexes
